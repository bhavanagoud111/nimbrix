{
  "title": "Nimbrix",
  "uid": "nimbrix-overview",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "API requests / s by route",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(nimbrix_http_requests_total[5m]))",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "API p95 latency",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(nimbrix_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "API 5xx and 429 responses",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(nimbrix_http_requests_total{status=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        },
        {
          "refId": "B",
          "expr": "sum(rate(nimbrix_http_requests_total{status=\"429\"}[5m]))",
          "legendFormat": "429"
        }
      ],
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Jobs processed by outcome",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, outcome) (increase(nimbrix_jobs_processed_total[15m]))",
          "legendFormat": "{{kind}} {{outcome}}"
        }
      ],
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Import duration p95",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(nimbrix_import_duration_seconds_bucket[1h])))",
          "legendFormat": "{{source}}"
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Import rows",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (increase(nimbrix_import_rows_total[1h]))",
          "legendFormat": "{{result}}"
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Agent model calls",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (provider, outcome) (increase(nimbrix_agent_model_calls_total[1h]))",
          "legendFormat": "{{provider}} {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum by (state, mode) (increase(nimbrix_investigations_total[1h]))",
          "legendFormat": "investigations {{state}} {{mode}}"
        }
      ],
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Recommendations by status",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (nimbrix_recommendations)",
          "legendFormat": "{{status}}"
        }
      ],
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Remediation outcomes and policy denials",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (increase(nimbrix_remediation_executions_total[1h]))",
          "legendFormat": "execution {{state}}"
        },
        {
          "refId": "B",
          "expr": "sum by (stage) (increase(nimbrix_policy_denials_total[1h]))",
          "legendFormat": "denied {{stage}}"
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Authentication",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(nimbrix_auth_events_total[1h]))",
          "legendFormat": "{{outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum by (bucket) (increase(nimbrix_rate_limited_total[1h]))",
          "legendFormat": "rate limited {{bucket}}"
        }
      ],
      "id": 10
    }
  ],
  "tags": [
    "nimbrix"
  ]
}