# Copy to .env (git-ignored) and adjust. Never commit real secrets.
# Nimbrix needs no cloud credentials or LLM API keys for the local demo.

# --- Docker Compose -------------------------------------------------------
# Local-only database password. Pick any value; it never leaves your machine.
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_USER=nimbrix
POSTGRES_DB=nimbrix

# Host ports (bound to 127.0.0.1). Defaults avoid the common 3000/8000/5432.
NIMBRIX_WEB_PORT=3200
NIMBRIX_API_PORT=8200
NIMBRIX_POSTGRES_PORT=5440
# Optional observability profile (`docker compose --profile observability up -d`).
NIMBRIX_PROMETHEUS_PORT=9290
NIMBRIX_GRAFANA_PORT=3290

# --- API (also read when running the API directly on the host) -----------
NIMBRIX_ENVIRONMENT=local
NIMBRIX_LOG_LEVEL=INFO
# Only needed when running outside Docker; Compose builds this from the values above.
NIMBRIX_DATABASE_URL=postgresql+psycopg://nimbrix:change-me-local-only@127.0.0.1:5440/nimbrix
# Comma-separated explicit origins. Empty is fine: the web app proxies API calls.
NIMBRIX_CORS_ALLOWED_ORIGINS=
# Must remain false: only simulated remediation exists.
NIMBRIX_LIVE_ACTIONS_ENABLED=false

# --- Demo (opt-in) -------------------------------------------------------------
# When true, `docker compose up` seeds demo tenants/users and queues synthetic data.
# `make demo` turns it on for you. Demo users log in with NIMBRIX_DEMO_PASSWORD.
NIMBRIX_DEMO_SEED=false
NIMBRIX_DEMO_PASSWORD=nimbrix-demo-password

# --- Optional AWS (read-only) ---------------------------------------------------
# Off by default. The demo never calls AWS. See docs/ingestion.md before enabling.
NIMBRIX_AWS_ENABLED=false

# --- Optional LLM for investigations ---------------------------------------------
# none = deterministic investigator (default, offline). openai | anthropic | ollama
NIMBRIX_LLM_PROVIDER=none
NIMBRIX_LLM_MODEL=
NIMBRIX_LLM_API_KEY=
NIMBRIX_LLM_BASE_URL=

# --- Web (when running `npm run dev` on the host) -------------------------
NIMBRIX_API_INTERNAL_URL=http://127.0.0.1:8200
# Optional: per-million-token prices so investigations can report LLM cost.
NIMBRIX_LLM_INPUT_USD_PER_MILLION_TOKENS=
NIMBRIX_LLM_OUTPUT_USD_PER_MILLION_TOKENS=

# --- Abuse protection and telemetry (defaults are fine for local use) ------------
NIMBRIX_RATE_LIMIT_REQUESTS_PER_MINUTE=600
NIMBRIX_OTEL_ENABLED=false
NIMBRIX_OTEL_EXPORTER_OTLP_ENDPOINT=
