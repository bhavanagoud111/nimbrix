{
  "name": "@nimbrix/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAPI document exported from the Nimbrix API and the TypeScript types generated from it.",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    },
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "openapi-typescript ./openapi.json --output ./src/schema.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5"
  }
}
