      "post": {
        "operationId": "create_connection_api_v1_connections_post",
        "parameters": [
          {
            "description": "Unique key per logical operation; retries with the same key are safe.",
            "in": "header",
            "name": "Idempotency-Key",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Unique key per logical operation; retries with the same key are safe.",
              "title": "Idempotency-Key"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
